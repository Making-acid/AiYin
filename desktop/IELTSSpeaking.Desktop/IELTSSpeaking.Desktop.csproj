<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\frontend\public\icons\app-icon.ico</ApplicationIcon>
    <AssemblyName>爱音</AssemblyName>
    <RootNamespace>IELTSSpeaking.Desktop</RootNamespace>
    <Version>1.3.0-beta.1</Version>
    <Product>爱音 Beta 1.3</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <!-- The WebView2 package references both UI adapters. This host is WinForms-only. -->
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_UnusedWebView2WpfReference Include="@(Reference)"
        Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_UnusedWebView2WpfReference)" />
    </ItemGroup>
  </Target>

</Project>
